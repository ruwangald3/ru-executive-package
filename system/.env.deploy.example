# ----------------------------------------------------------------------------
# [OPS] Executive Artifact Deployment System — credential file
# ----------------------------------------------------------------------------
# Copy this file to `system/.env.deploy` (no .example) and fill in real values.
# `system/.env.deploy` is git-ignored — never commit it.
#
# All future "Ship this to Vercel" runs source this file automatically.
# ----------------------------------------------------------------------------

# ----- GitHub (used by Cowork sandbox to push commits) -----
# Required for sandbox-side autonomy: vercel.com is blocked from sandbox,
# so deployment happens via GitHub → Vercel auto-deploy integration.
#
# Create a fine-grained PAT:
#   https://github.com/settings/tokens?type=beta
#   Scopes needed: "Contents: read & write" on the target repo only
#
GITHUB_USERNAME=
GITHUB_TOKEN=
GITHUB_REPO=                  # e.g. ruwangad/executive-artifacts
GITHUB_DEFAULT_BRANCH=main

# ----- Vercel (used when running ship.sh from a host that CAN reach vercel.com,
#       e.g. your local Windows machine — NOT required for sandbox deploys) -----
# Token: https://vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_TEAM=                  # optional — team slug if deploying to a team scope

# ----- Project naming -----
# If unset, ship.sh defaults to the artifact case folder name
# (e.g. ru-executive-package-v1).
VERCEL_PROJECT_NAME=
